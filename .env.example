# DocuBricks — environment configuration
# Copy to .env and fill in values. Never commit .env.

# ── Databricks workspace ───────────────────────────────────────────────────
DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
DATABRICKS_TOKEN=dapi...

# ── Bundle targets ──────────────────────────────────────────────────────────
# Set via CLI flag: --target dev | staging | prod
# Or set here for default:
DATABRICKS_TARGET=dev

# ── Unity Catalog ───────────────────────────────────────────────────────────
CATALOG_NAME=docubricks_prod
SCHEMA_TIER=community          # community | starter | professional | enterprise

# ── Lakebase (PostgreSQL) ───────────────────────────────────────────────────
# Format: postgresql://user:password@host:5432/dbname?sslmode=require
LAKEBASE_CONN=postgresql://...

# ── Databricks Secret Scope ─────────────────────────────────────────────────
# All secrets below must be stored in this scope in your workspace
SECRET_SCOPE=docubricks-prod

# Secrets stored in the scope (do not put real values here — use scope):
#   lakebase-conn-string    → LAKEBASE_CONN value
#   pipeline-job-id         → filled automatically after bootstrap
#   genie-space-id-fs       → filled automatically after bootstrap
#   genie-space-id-hc       → filled automatically after bootstrap (Professional+)
#   sql-warehouse-http-path → /sql/1.0/warehouses/your-warehouse-id

# ── SQL Warehouse ────────────────────────────────────────────────────────────
SQL_WAREHOUSE_ID=your-warehouse-id
SQL_WH_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id

# ── Observability (optional) ────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=   # leave empty to disable OTel export
OTEL_SERVICE_NAME=docubricks

# ── Feature flags ───────────────────────────────────────────────────────────
ENABLE_AGENTS=false             # set true for Professional+ tier
VERTICAL=fs                     # primary vertical: fs | healthcare | legal
